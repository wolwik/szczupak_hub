{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.answer_edit'|trans }}
{% endblock %}

{% block body %}

    <div class="container py-4">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card shadow-sm border-0">

                    <div class="card-body p-4">

                        <h3 class="mb-4">{{ 'label.answer_edit'|trans }}</h3>

                        {{ form_start(form) }}
                        {{ form_widget(form) }}

                        <div class="d-flex justify-content-between align-items-center mt-4">

                            <a href="{{ url('question_view', {id: answer.question.id}) }}" class="btn btn-outline-secondary btn-sm">
                                {{ 'label.back'|trans }}
                            </a>

                            <button type="submit" class="btn btn-primary">
                                {{ 'label.save'|trans }}
                            </button>

                        </div>

                        {{ form_end(form) }}

                    </div>

                </div>

            </div>

        </div>

    </div>


{% endblock %}


