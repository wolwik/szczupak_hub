{% extends 'base.html.twig' %}

{% block title %}{{ 'title.user_list'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'label.user_list'|trans }}</h1>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'label.id'|trans }}</th>
            <th>{{ 'label.nickname'|trans }}</th>
            <th>{{ 'label.email'|trans }}</th>
            <th>{{ 'label.roles'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.nickname }}</td>
                <td>{{ user.email }}</td>
                <td>
                    {% for role in user.roles %}
                        <span class="badge bg-secondary">
                            {{ role.value ?? role }}
                        </span>
                    {% endfor %}
                </td>

                <td>
                    <a href="{{ path('user_edit', {'id': user.id}) }}" class="btn btn-sm btn-primary">{{ 'label.edit'|trans }}</a>
                    <a href="{{ path('user_delete', {'id': user.id}) }}" class="btn btn-sm btn-danger">{{ 'label.delete'|trans }}</a>
                    <a href="{{ path('user_change_password', {'id': user.id}) }}" class="btn btn-sm btn-warning">{{ 'label.change_password'|trans }}</a>

                    {% if user.isAdmin %}
                        <a href="{{ path('user_remove_admin', {'id': user.id}) }}" class="btn btn-sm btn-info">{{ 'label.remove_admin'|trans }}</a>
                    {% else %}
                        <a href="{{ path('user_make_admin', {'id': user.id}) }}" class="btn btn-sm btn-success">{{ 'label.make_admin'|trans }}</a>
                    {% endif %}

                    {% if user.isBlocked %}
                        <a href="{{ path('user_unblock_admin', {'id': user.id}) }}" class="btn btn-sm btn-success">{{ 'label.unblock'|trans }}</a>
                    {% else %}
                        <a href="{{ path('user_block_admin', {'id': user.id}) }}" class="btn btn-sm btn-dark">{{ 'label.block'|trans }}</a>
                    {% endif %}

                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
