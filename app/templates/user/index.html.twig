{% extends 'base.html.twig' %}

{% block title %}User index{% endblock %}

{% block body %}
    <h1>User index</h1>

    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>Nickname</th>
            <th>Email</th>
            <th>Role</th>
        </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.nickname }}</td>
                <td>{{ user.email }}</td>
                <td>
                    {% for role in user.roles %}
                        <span class="badge bg-secondary">
                            {{ role.value ?? role }}
                        </span>
                    {% endfor %}
                </td>

                <td>
                    <a href="{{ path('user_edit', {'id': user.id}) }}" class="btn btn-sm btn-primary">edit</a>
                    <a href="{{ path('user_delete', {'id': user.id}) }}" class="btn btn-sm btn-danger">delete</a>
                    {% if user.isAdmin %}
                        <a href="{{ path('user_remove_admin', {'id': user.id}) }}" class="btn btn-sm btn-warning">remove admin</a>
                    {% else %}
                        <a href="{{ path('user_make_admin', {'id': user.id}) }}" class="btn btn-sm btn-info">make admin</a>
                    {% endif %}


                    {% if user.isBlocked %}
                        <a href="{{ path('user_unblock_admin', {'id': user.id}) }}" class="btn btn-sm btn-success">unblock</a>
                    {% else %}
                        <a href="{{ path('user_block_admin', {'id': user.id}) }}" class="btn btn-sm btn-dark">block</a>
                    {% endif %}

                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
