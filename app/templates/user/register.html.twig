{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.user_register'|trans }}
{% endblock %}

{% block body %}

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-md-6 col-lg-5">

                <div class="card shadow-sm border-0">

                    <div class="card-body p-4">

                        <h3 class="text-center mb-4">{{ 'label.register_yourself'|trans }}</h3>

                        {{ form_start(form) }}

                        <div class="mb-3">
                            {{ form_row(form.email) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.nickname) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.password) }}
                        </div>

                        <button class="btn btn-primary w-100 mt-2">
                            {{ 'label.create_account'|trans }}
                        </button>

                        {{ form_end(form) }}

                        <hr class="my-4">

                        <div class="text-center small">
                            {{ 'label.have_account'|trans }}
                            <a href="{{ path('app_login') }}">{{ 'label.login'|trans }}</a>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

{% endblock %}
