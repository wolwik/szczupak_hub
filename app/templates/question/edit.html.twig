{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.question_edit'|trans({'%id%': question.id|default('')}) }}
{% endblock %}

{% block body %}

    <div class="container py-4">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card shadow-sm border-0">

                    <div class="card-body p-4">

                        <h3 class="mb-4">
                            {{ 'label.question_edit'|trans }} #{{ question.id }}
                        </h3>

                        {{ form_start(form) }}

                        <div class="mb-3">
                            {{ form_row(form.title) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.content) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.category) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.tags) }}
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">

                            <a href="{{ url('question_view', {id: question.id}) }}"
                               class="btn btn-outline-secondary btn-sm">
                                {{ 'label.back'|trans }}
                            </a>

                            <button type="submit" class="btn btn-primary">
                                {{ 'label.save'|trans }}
                            </button>

                        </div>

                        {{ form_end(form) }}

                    </div>

                </div>

            </div>

        </div>

    </div>

{% endblock %}
