{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.question_edit'|trans({'%id%': question.id|default('')}) }}
{% endblock %}

{% block body %}

    <div class="container py-4">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card shadow-sm border-0">

                    <div class="card-body p-4">

                        <h3 class="mb-4">
                            {{ 'label.question_edit'|trans }} #{{ question.id }}
                        </h3>

                        {{ form_start(form) }}

                        <div class="mb-3">
                            {{ form_row(form.title) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.content) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.category) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.tags) }}
                        </div>

                        {% set current_photo = get_question_photo(question) %}
                        {% if current_photo %}
                            <div class="mb-2">
                                <p class="small text-muted mb-1">{{ 'label.current_photo'|trans }}:</p>
                                <img src="{{ asset('uploads/question-photos/' ~ current_photo) }}" class="img-thumbnail" style="max-height: 120px;" alt="{{ 'label.current_photo'|trans }}">
                            </div>
                            <a href="{{ url('question_photo_delete', {id: question.id}) }}" class="btn btn-outline-danger btn-sm">
                                {{ 'label.photo_delete'|trans }}
                            </a>
                        {% endif %}

                        <div class="mb-3">
                            {{ form_row(form.photo) }}
                        </div>



                        <div class="d-flex justify-content-between align-items-center mt-4">

                            <a href="{{ url('question_view', {id: question.id}) }}"
                               class="btn btn-outline-secondary btn-sm">
                                {{ 'label.back'|trans }}
                            </a>

                            <button type="submit" class="btn btn-primary">
                                {{ 'label.save'|trans }}
                            </button>

                        </div>

                        {{ form_end(form) }}

                    </div>

                </div>

            </div>

        </div>

    </div>

{% endblock %}
