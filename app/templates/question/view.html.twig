{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.question_view'|trans }}
{% endblock %}

{% block body %}

    <div class="container">

        <!-- QUESTION -->
        <div class="card mb-4 shadow-sm">
            <div class="card-body">

                <p class="text-muted small mb-2">
                    {{ question.category ? question.category.name : "Brak kategorii" }}
                </p>

                <h2 class="mb-3">{{ question.title }}</h2>

                <div class="d-flex gap-2">

                    <div class="avatar-wrapper avatar-md">
                        {% set question_author_avatar = get_user_avatar(question.author) %}

                        {% if question_author_avatar %}
                            <img
                                src="{{ asset('uploads/avatars/' ~ question_author_avatar) }}"
                                class="avatar-img"
                                alt="avatar"
                            >
                        {% else %}
                            <img
                                src="{{ asset('images/default-user.jpg') }}"
                                class="avatar-img"
                                alt="default avatar"
                            >
                        {% endif %}
                    </div>

                    <div>

                        <div class="d-flex align-items-center gap-2 mb-2 text-muted small">

                            {% if question.author %}
                                <span class="text-primary fw-bold">{{ question.author.nickname}}</span>
                            {% else %}
                                <span class="text-muted">{{ 'label.deleted_user'|trans }}</span>
                            {% endif %}

                            {% if question.author %}
                                {% if 'ROLE_ADMIN' in question.author.roles %}
                                    <span class="badge bg-danger">admin</span>
                                {% endif %}
                            {% endif %}
                        </div>

                        <p class="text-muted small">{{ question.createdAt|date('Y-m-d H:i') }}</p>

                        <div class="mb-3">
                            {% for tag in question.tags %}
                                <span class="badge bg-secondary me-1">
                                {{ tag.slug }}
                            </span>
                            {% else %}
                                <span class="text-muted">{{ 'label.no_tags'|trans }}</span>
                            {% endfor %}
                        </div>

                    </div>

                </div>

                <p class="mb-4">
                    {{ question.content|markdown_to_html|replace({'<h1>':'<h3>', '</h1>':'</h3>', '<h2>':'<h3>', '</h2>':'</h3>'})|raw }}
                </p>

                <div class="d-flex gap-2">
                    <a href="{{ url('question_list') }}" class="btn btn-outline-secondary btn-sm">
                        Back
                    </a>

                    {% if is_granted('QUESTION_EDIT', question) %}
                        <a href="{{ url('question_edit', {id: question.id}) }}" class="btn btn-outline-primary btn-sm">
                            {{ 'label.edit'|trans }}
                        </a>
                    {% endif %}

                    {% if is_granted('QUESTION_DELETE', question) %}
                        <a href="{{ url('question_delete', {id: question.id}) }}" class="btn btn-outline-danger btn-sm">
                            {{ 'label.delete'|trans }}
                        </a>
                    {% endif %}
                </div>

            </div>
        </div>


        {% if question.status.value == 'published' %}


            <!-- ANSWERS -->
            <div class="card mb-4 shadow-sm">
                <div class="card-body">

                    <h4 class="mb-4">{{ 'label.answers'|trans }}</h4>

                    {% if question.answers is empty %}
                        <p class="text-muted">{{ 'label.no_answers'|trans }}</p>
                    {% else %}

                        {% for answer in question.answers %}

                            {% set isBest = question.bestAnswer == answer %}

                            <div class="border rounded p-3 mb-3
                            {% if isBest %}border-success bg-success-subtle{% endif %}">

                                <!-- HEADER -->
                                <div class="d-flex justify-content-between align-items-start mb-2">

                                    <div class="d-flex gap-2">

                                        <div class="avatar-wrapper avatar-sm ">
                                            {% set answer_author_avatar = get_user_avatar(answer.author) %}

                                            {% if answer_author_avatar %}
                                                <img
                                                    src="{{ asset('uploads/avatars/' ~ answer_author_avatar) }}"
                                                    class="avatar-img"
                                                    alt="avatar"
                                                >
                                            {% else %}
                                                <img
                                                    src="{{ asset('images/default-user.jpg') }}"
                                                    class="avatar-img"
                                                    alt="default avatar"
                                                >
                                            {% endif %}
                                        </div>


                                        <div class="text-muted small">
                                            <div class="d-flex align-items-center gap-2">

                                                {% if answer.author %}
                                                    <span class="text-primary fw-bold">{{ answer.author.nickname}}</span>
                                                {% else %}
                                                    <span class="text-muted">{{ 'label.deleted_user'|trans }}</span>
                                                {% endif %}

                                                {% if answer.author %}
                                                    {% if 'ROLE_ADMIN' in answer.author.roles %}
                                                        <span class="badge bg-danger">admin</span>
                                                    {% endif %}
                                                {% endif %}
                                            </div>

                                            <div>
                                                {{ answer.createdAt|date('Y-m-d H:i') }}
                                            </div>

                                        </div>


                                    </div>

                                    {% if answer.updatedAt %}
                                        <div class="text-muted small">
                                            {{ 'label.updated'|trans }} {{ answer.updatedAt|date('Y-m-d H:i') }}
                                        </div>
                                    {% endif %}

                                </div>

                                <!-- BEST BADGE -->
                                {% if isBest %}
                                    <span class="badge bg-success mb-2">
                                    {{ 'label.best_answer'|trans }}
                                </span>
                                {% endif %}

                                <!-- CONTENT -->
                                <p class="mb-3">
                                    {{ answer.content|markdown_to_html|replace({'<h1>':'<h3>', '</h1>':'</h3>', '<h2>':'<h3>', '</h2>':'</h3>'})|raw }}
                                </p>

                                <!-- ACTIONS -->
                                <div class="d-flex gap-2 flex-wrap">


                                    <!-- VOTING -->
                                    <a href="{{ path('answer_vote', {id: answer.id}) }}">
                                        👍 {{ get_answer_votes(answer) }}
                                    </a>


                                    {% if is_granted('ANSWER_EDIT', answer) %}
                                        <a href="{{ url('answer_edit', {id: answer.id}) }}"
                                           class="btn btn-sm btn-outline-primary">
                                            {{ 'label.edit'|trans }}
                                        </a>
                                    {% endif %}

                                    {% if is_granted('ANSWER_DELETE', answer) %}
                                        <a href="{{ url('answer_delete', {id: answer.id}) }}"
                                           class="btn btn-sm btn-outline-danger">
                                            {{ 'label.delete'|trans }}
                                        </a>
                                    {% endif %}



                                </div>

                            </div>

                        {% endfor %}

                    {% endif %}

                </div>
            </div>


            <!-- FORM -->
            <div class="card shadow-sm">
                <div class="card-body">

                    {% if app.user %}

                        <h5 class="mb-3">{{ 'label.answer_add'|trans }}</h5>

                        {{ form_errors(answerForm) }}

                        {{ form_start(answerForm, {
                            action: path('answer_create', {id: question.id}),
                            method: 'POST'
                        }) }}

                        {{ form_widget(answerForm) }}

                        <p class="text-muted p-block">
                            {{ 'label.markdown_info'|trans }}
                        </p>

                        <button type="submit" class="btn btn-primary mt-3">
                            {{ 'label.publish'|trans }}
                        </button>


                        {{ form_end(answerForm) }}



                    {% else %}

                        <p class="text-muted mb-0">
                            <a href="{{ url('app_login') }}">{{ 'label.login'|trans }}</a>{{ 'label.or'|trans }}<a href="{{ url('register') }}">{{ 'label.register'|trans }}</a>{{ 'label.to_answer'|trans }}
                        </p>

                    {% endif %}

                </div>
            </div>


        {% else %}

            <a href="{{ path('question_publish', {id: question.id}) }}" class="btn btn-success btn mb-4">{{ 'label.publish'|trans }}</a>

        {% endif %}


    </div>

{% endblock %}
