{% extends 'base.html.twig' %}

{% block title %}
    View question
{% endblock %}

{% block body %}

    <!-- QUESTION -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">

            <p class="text-muted small mb-2">{{ question.category ? question.category.name : "Brak kategorii" }}</p>

            <h1 class="mb-3">{{ question.title }}</h1>
            <p>{{ question.author.nickname }}</p>
            {% if 'ROLE_ADMIN' in question.author.roles %}
                <span class="badge bg-danger">admin</span>
            {% endif %}
            {% for tag in question.tags %}
                <span class="badge bg-secondary">
                    {{ tag.slug }}
                </span>
            {% else %}
                <span class="text-muted">brak tagów</span>
            {% endfor %}

            <p>{{ question.content }}</p>

            <a href="{{ url('question_list') }}" class="btn btn-outline-secondary btn-sm">Back</a>

            {% if is_granted('QUESTION_EDIT', question) %}
                <a href="{{ url('question_edit', {id: question.id}) }}" class="btn btn-outline-secondary btn-sm">Edit</a>
            {% endif %}

            {% if is_granted('QUESTION_DELETE', question) %}
                <a href="{{ url('question_delete', {id: question.id}) }}" class="btn btn-outline-secondary btn-sm">Delete</a>
            {% endif %}
        </div>
    </div>


    <!-- ANSWERS -->
    <div class="card mb-4">

        <div class="card-body">

            <h4 class="mb-3">Odpowiedzi</h4>

            {% if question.answers is empty %}
                <p class="text-muted">Brak odpowiedzi</p>
            {% else %}
                {% for answer in question.answers %}

                    {% set isBest = question.bestAnswer == answer %}

                    {% if isBest %}
                        <div class="mb-2">
                            <span class="badge bg-success">
                                ✓ Najlepsza odpowiedź
                            </span>
                        </div>
                    {% endif %}



                    <div class="border-bottom pb-3 mb-3">
                        <div class="rounded-3 p-3 mb-3 {% if isBest %}border border-success bg-success-subtle{% else %}border{% endif %}">

                        <div class="d-flex justify-content-between text-muted small mb-2 ">

                            <div>
                                <p>{{ answer.author.nickname }}</p>
                                {% if 'ROLE_ADMIN' in answer.author.roles %}
                                    <span class="badge bg-danger">admin</span>
                                {% endif %}
                                <p>{{ answer.createdAt|date('Y-m-d H:i') }}</p>
                            </div>
                            {%  if answer.updatedAt %}
                                <div class="text-muted small mb-2">
                                    <p>Ostatnia edycja: {{ answer.updatedAt|date('Y-m-d H:i') }}</p>
                                </div>
                            {% endif %}

                            <p class="mb-2">{{ answer.content }}</p>

                        </div>


                        <!-- buttons -->
                        <div>
                            {% if is_granted('ANSWER_EDIT', answer) %}
                                <a href="{{ url('answer_edit', {id: answer.id}) }}"
                                class="btn btn-sm btn-primary">
                                    Edytuj
                                </a>
                            {% endif %}
                            {% if is_granted('ANSWER_DELETE', answer) %}
                                <a href="{{ url('answer_delete', {id: answer.id}) }}"
                                class="btn btn-sm btn-danger">
                                    Usuń
                                </a>
                            {% endif %}

                            {% if is_granted('ANSWER_MARK_AS_BEST', answer) %}
                                <a href="{{ url('answer_best', {id: answer.id}) }}">
                                    Oznacz jako najlepsza
                                </a>
                            {% endif %}

                        </div>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>



        <!--FORMULARZ DODAWANIA ODPOWIEDZI-->
        <div>
            {% if app.user %}

                {{ form_start(answerForm, {
                    action: path('answer_create', {id: question.id}),
                    method: 'POST'
                }) }}

                {{ form_widget(answerForm) }}

                <button type="submit">
                    Dodaj odpowiedz
                </button>

                {{ form_end(answerForm) }}

            {% else %}
                <p>
                    <a href="{{ url('app_login') }}">Zaloguj się</a>, aby dodać odpowiedź.
                </p>
            {% endif %}
        </div>

{% endblock %}

