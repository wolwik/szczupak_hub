{% extends 'base.html.twig' %}

{% block title %}
    View question
{% endblock %}

{% block body %}

    <div class="container">

        <!-- QUESTION -->
        <div class="card mb-4 shadow-sm">
            <div class="card-body">

                <p class="text-muted small mb-2">
                    {{ question.category ? question.category.name : "Brak kategorii" }}
                </p>

                <h2 class="mb-3">{{ question.title }}</h2>

                <div class="d-flex align-items-center gap-2 mb-2 text-muted small">

                    {% if question.author %}
                        <span>Autor: {{ question.author.nickname}}</span>
                    {% else %}
                        <span class="text-muted">[ deleted user ]</span>
                    {% endif %}

                    {% if question.author %}
                        {% if 'ROLE_ADMIN' in question.author.roles %}
                            <span class="badge bg-danger">admin</span>
                        {% endif %}
                    {% endif %}
                </div>

                <div class="mb-3">
                    {% for tag in question.tags %}
                        <span class="badge bg-secondary me-1">
                        {{ tag.slug }}
                    </span>
                    {% else %}
                        <span class="text-muted">brak tagów</span>
                    {% endfor %}
                </div>

                <p class="mb-4">
                    {{ question.content|markdown_to_html|replace({'<h1>':'<h3>', '</h1>':'</h3>', '<h2>':'<h3>', '</h2>':'</h3>'})|raw }}
                </p>

                <div class="d-flex gap-2">
                    <a href="{{ url('question_list') }}" class="btn btn-outline-secondary btn-sm">
                        Back
                    </a>

                    {% if is_granted('QUESTION_EDIT', question) %}
                        <a href="{{ url('question_edit', {id: question.id}) }}" class="btn btn-outline-primary btn-sm">
                            Edit
                        </a>
                    {% endif %}

                    {% if is_granted('QUESTION_DELETE', question) %}
                        <a href="{{ url('question_delete', {id: question.id}) }}" class="btn btn-outline-danger btn-sm">
                            Delete
                        </a>
                    {% endif %}
                </div>

            </div>
        </div>


        {% if question.status.value == 'published' %}


                            <!-- ANSWERS -->
                            <div class="card mb-4 shadow-sm">
                                <div class="card-body">

                                    <h4 class="mb-4">Odpowiedzi</h4>

                                    {% if question.answers is empty %}
                                        <p class="text-muted">Brak odpowiedzi</p>
                                    {% else %}

                                        {% for answer in question.answers %}

                                            {% set isBest = question.bestAnswer == answer %}

                                            <div class="border rounded p-3 mb-3
                                            {% if isBest %}border-success bg-success-subtle{% endif %}">

                                                <!-- HEADER -->
                                                <div class="d-flex justify-content-between align-items-start mb-2">

                                                    <div class="text-muted small">
                                                        <div class="d-flex align-items-center gap-2">

                                                            {% if answer.author %}
                                                                <span class="text-primary fw-bold">{{ answer.author.nickname}}</span>
                                                            {% else %}
                                                                <span class="text-muted">[ deleted user ]</span>
                                                            {% endif %}

                                                            {% if answer.author %}
                                                                {% if 'ROLE_ADMIN' in answer.author.roles %}
                                                                    <span class="badge bg-danger">admin</span>
                                                                {% endif %}
                                                            {% endif %}
                                                        </div>

                                                        <div>
                                                            {{ answer.createdAt|date('Y-m-d H:i') }}
                                                        </div>
                                                    </div>

                                                    {% if answer.updatedAt %}
                                                        <div class="text-muted small">
                                                            Edytowano: {{ answer.updatedAt|date('Y-m-d H:i') }}
                                                        </div>
                                                    {% endif %}

                                                </div>

                                                <!-- BEST BADGE -->
                                                {% if isBest %}
                                                    <span class="badge bg-success mb-2">
                                                    Najlepsza odpowiedź
                                                </span>
                                                {% endif %}

                                                <!-- CONTENT -->
                                                <p class="mb-3">
                                                    {{ answer.content|markdown_to_html|replace({'<h1>':'<h3>', '</h1>':'</h3>', '<h2>':'<h3>', '</h2>':'</h3>'})|raw }}
                                                </p>

                                                <!-- ACTIONS -->
                                                <div class="d-flex gap-2 flex-wrap">

                                                    {% if is_granted('ANSWER_EDIT', answer) %}
                                                        <a href="{{ url('answer_edit', {id: answer.id}) }}"
                                                           class="btn btn-sm btn-outline-primary">
                                                            Edytuj
                                                        </a>
                                                    {% endif %}

                                                    {% if is_granted('ANSWER_DELETE', answer) %}
                                                        <a href="{{ url('answer_delete', {id: answer.id}) }}"
                                                           class="btn btn-sm btn-outline-danger">
                                                            Usuń
                                                        </a>
                                                    {% endif %}

                                                    {% if is_granted('ANSWER_MARK_AS_BEST', answer) %}
                                                        <a href="{{ url('answer_best', {id: answer.id}) }}"
                                                           class="btn btn-sm btn-outline-success">
                                                            Oznacz jako najlepsza
                                                        </a>
                                                    {% endif %}

                                                </div>

                                            </div>

                                        {% endfor %}

                                    {% endif %}

                                </div>
                            </div>


                            <!-- FORM -->
                            <div class="card shadow-sm">
                                <div class="card-body">

                                    {% if app.user %}

                                        <h5 class="mb-3">Dodaj odpowiedź</h5>

                                        {{ form_start(answerForm, {
                                            action: path('answer_create', {id: question.id}),
                                            method: 'POST'
                                        }) }}

                                        {{ form_widget(answerForm) }}

                                        <p class="text-muted p-block">
                                            Możesz użyć formatu markdown!
                                        </p>

                                        <button type="submit" class="btn btn-primary mt-3">
                                            Dodaj odpowiedź
                                        </button>


                                        {{ form_end(answerForm) }}

                                    {% else %}

                                        <p class="text-muted mb-0">
                                            <a href="{{ url('app_login') }}">Zaloguj </a> lub <a href="{{ url('register') }}">zarejestruj</a> się, aby dodać odpowiedź.
                                        </p>

                                    {% endif %}

                                </div>
                            </div>


        {% else %}

            <a href="{{ path('question_publish', {id: question.id}) }}" class="btn btn-success btn mb-4">Opublikuj</a>

        {% endif %}


    </div>

{% endblock %}
