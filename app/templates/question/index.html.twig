{% extends 'base.html.twig' %}

{% block title %}{{ 'title.question_list'|trans }}{% endblock %}

{% block body %}

    <div class="container py-4">
        <div class="row g-4">

            <!-- LEFT: FEED -->
            <div class="col-lg-9">

                <h1 class="mb-4">{{ 'label.question_list'|trans }}</h1>

                {% if pagination is defined and pagination.items|length %}

                    <!-- ACTION BAR -->
                    <div class="d-flex">

                        {% if app.user %}
                            <a href="{{ url('question_create') }}" class="btn btn-success btn mb-4">
                                {{ 'label.add_question'|trans }}
                            </a>
                        {% else %}

                            <div class="card shadow-sm mb-4">
                                <div class="card-body bg-warning p-3">

                                    <a href="{{ url('app_login') }}" class="text-decoration-underline">{{ 'label.login'|trans }}</a>
                                    {{ 'label.or'|trans }}
                                    <a href="{{ url('register') }}" class="text-decoration-underline">{{ 'label.register'|trans }}</a>
                                    {{ 'label.to_ask'|trans }}

                                </div>
                            </div>

                        {% endif %}
                    </div>

                    <!-- PAGINATION -->
                    <div class="text-center mb-3">
                        {{ knp_pagination_render(pagination) }}
                    </div>

                    <!-- QUESTIONS -->
                    <div class="d-flex flex-column gap-3">

                        {% for question in pagination.items %}

                            <div class="card shadow-sm">

                                <div class="card-body">

                                    <!-- CATEGORY -->
                                    <p class="mb-1 small text-muted">
                                        {{ question.category.name }}
                                    </p>

                                    <!-- TITLE -->
                                    <h5 class="mb-1">
                                        <a href="{{ url('question_view', {id: question.id}) }}"
                                           class="text-decoration-none">
                                            {{ question.title|markdown_to_html }}
                                        </a>
                                    </h5>

                                    <!-- META -->
                                    <div class="text-muted small mb-2 d-flex flex-wrap gap-2">

                                        <div class="d-flex align-items-center gap-3 ">

                                            <div class="avatar-wrapper avatar-md">
                                                {% set avatar_filename = get_user_avatar(question.author) %}

                                                {% if avatar_filename %}
                                                    <img
                                                        src="{{ asset('uploads/avatars/' ~ avatar_filename) }}"
                                                        class="avatar-img"
                                                        alt="avatar"
                                                    >
                                                {% else %}
                                                    <img
                                                        src="{{ asset('images/default-user.jpg') }}"
                                                        class="avatar-img"
                                                        alt="default avatar"
                                                    >
                                                {% endif %}
                                            </div>

                                            <div>
                                            <p class="mb-1">
                                                {% if question.author %}
                                                    <span class="text-primary fw-bold">{{ question.author.nickname }}</span>
                                                {% else %}
                                                    <span class="text-muted">{{ 'label.deleted_user'|trans }}</span>
                                                {% endif %}
                                            </p>

                                            <p class="mb-1">{{ question.createdAt|date('Y-m-d H:i') }}</p>

                                            {% if question.updatedAt %}
                                                <p class="text-muted small">
                                                ({{ 'label.updated'|trans }} {{ question.updatedAt|date('Y-m-d H:i') }})
                                            </p>
                                            {% endif %}

                                            </div>
                                        </div>


                                    </div>

                                    <!-- CONTENT PREVIEW -->
                                    <p class="mb-2 text-muted">
                                        {{ question.content|markdown_to_html|replace({'<h1>':'<h3>', '</h1>':'</h3>', '<h2>':'<h3>', '</h2>':'</h3>'})|raw }}
                                    </p>

                                    <!-- TAGS -->
                                    <div class="d-flex flex-wrap gap-1">

                                        {% for tag in question.tags %}
                                            <a href="{{ path('question_list', {tag: tag.id}) }}"
                                               class="badge bg-primary text-decoration-none">
                                                {{ tag.slug }}
                                            </a>
                                        {% else %}
                                            <span class="text-muted small">{{ 'label.no_tags' }}</span>
                                        {% endfor %}

                                    </div>

                                </div>

                            </div>

                        {% endfor %}

                    </div>

                    <!-- PAGINATION BOTTOM -->
                    <div class="text-center mt-4">
                        {{ knp_pagination_render(pagination) }}
                    </div>

                {% else %}
                    <p class="text-muted">
                        {{ 'message.empty_list'|trans }}
                    </p>
                {% endif %}

            </div>

            <!-- RIGHT: SIDEBAR -->
            <div class="col-lg-3">

                <div class="card shadow-sm">
                    <div class="card-body">

                        <h5 class="mb-3">{{ 'label.categories'|trans }}</h5>

                        <ul class="list-unstyled gap-2 d-flex flex-wrap">

                            <li class="mb-2">
                                <a href="{{ path('question_list') }}" class="btn btn-sm btn-outline-info text-decoration-none">
                                    {{ 'label.all'|trans }}
                                </a>
                            </li>

                            {% for category in categories %}
                                <li class="mb-2">
                                    <a href="{{ path('question_list', {categoryId: category.id}) }}" class="btn btn-sm btn-info text-decoration-none">
                                        {{ category.name }}
                                    </a>
                                </li>
                            {% endfor %}

                        </ul>

                    </div>
                </div>

                <div class="card shadow-sm mt-4">
                    <div class="card-body">

                        <h5>{{ 'label.quote_title'|trans }}</h5>
                        <figure>
                            <blockquote class="blockquote">
                                <p>{{ 'label.quote'|trans }}</p>
                            </blockquote>
                            <figcaption class="blockquote-footer">
                                SandaczHunter3000 <cite title="Source Title">SPŁAWIK i GRUNT - Postępowy Portal Wędkarski</cite>
                            </figcaption>
                        </figure>
                    </div>
                </div>

            </div>

        </div>
    </div>

{% endblock %}
