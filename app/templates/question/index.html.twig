{% extends 'base.html.twig' %}

{% block title %}Hello QuestionController!{% endblock %}

{% block body %}

    <!-- LEWA STRONA -->
    <div>

        <!-- LISTA PYTAŃ -->
        <h1>{{ 'label.question_list'|trans }}</h1>

        {% if pagination is defined and pagination.items|length %}

        <div class="navigation text-center">
            {{ knp_pagination_render(pagination) }}
        </div>

        {% if app.user %}
            <a href="{{ url('question_create') }}">Zadaj pytanie</a>
        {% else %}
            <p>
                <a href="{{ url('app_login') }}">Zaloguj </a> lub <a href="{{ url('register') }}">zarejestruj</a> się, aby zadań pytanie.
            </p>
        {% endif %}


        <table>
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(pagination, 'label.title'|trans, 'question.createdAt') }}</th>
                    <th>{{ knp_pagination_sortable(pagination, 'label.created_at'|trans, 'question.createdAt') }}</th>
                    <th>Autor</th>
                    <th>{{ 'label.category'|trans }}</th>
                    <th>Tagi</th>
                    <th>{{ 'label.content'|trans }}</th>
                    <th>Link</th>
                    <!--<th>Delete</th>-->

                </tr>
            </thead>

            <tbody>
                {% for question in pagination.items %}
                    <tr>
                        <td>{{ question.title }}</td>
                        <td>
                            <p>{{ question.createdAt|date('Y-m-d H:i') }}</p>
                            {%  if question.updatedAt %}
                                <p>Ostatnia edycja: {{ question.updatedAt|date('Y-m-d H:i') }}</p>
                            {% endif %}
                        </td>
                        <td>{{ question.author.nickname }}</td>
                        <td>{{ question.category.name }}</td>
                        <!--tagi-->
                        <td>
                            {% for tag in question.tags %}
                                <span class="badge bg-secondary">
                                    <a href="{{ path('question_list', {tag: tag.id}) }}">
                                        {{ tag.slug }}
                                    </a>
                                </span>
                            {% else %}
                                <span class="text-muted">brak tagów</span>
                            {% endfor %}
                        </td>

                        <td>{{ question.content }}</td>
                        <td><a href="{{ url('question_view', {id: question.id}) }}">Link</a></td>
                        <!--<td><a href="{{ url('question_delete', {id: question.id}) }}">Delete</a></td>-->
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="navigation text-center">
            {{ knp_pagination_render(pagination) }}
        </div>

        {% else %}
            <p>
                {{ 'message.empty_list'|trans }}
            </p>
        {% endif %}

    </div>


    <!-- PRAWA STRONA [filtry] -->
    <div>
        <h2>Kategorie</h2>

        <ul>
            <li><a href="{{ path('question_list') }}">
                    Wszystkie
                </a>
            </li>
            {% for category in categories %}
                <li>
                    <a href="{{ path('question_list', {categoryId: category.id}) }}">
                        {{ category.name }}
                    </a>
                </li>
            {% endfor %}
        </ul>

    </div>


{% endblock %}

