{% extends 'base.html.twig' %}

{% block title %}Hello QuestionController!{% endblock %}

{% block body %}

    <div class="container py-4">
        <div class="row g-4">

            <!-- LEFT: FEED -->
            <div class="col-lg-9">

                <h1 class="mb-4">{{ 'label.question_list'|trans }}</h1>

                {% if pagination is defined and pagination.items|length %}

                    <!-- ACTION BAR -->
                    <div class="d-flex">

                        {% if app.user %}
                            <a href="{{ url('question_create') }}" class="btn btn-success btn mb-4">
                                Zadaj pytanie
                            </a>
                        {% else %}

                            <div class="card shadow-sm mb-4">
                                <div class="card-body bg-warning p-3">

                                    <a href="{{ url('app_login') }}" class="text-decoration-underline">Zaloguj</a>
                                    lub
                                    <a href="{{ url('register') }}" class="text-decoration-underline">zarejestruj</a>
                                    aby zadać pytanie!

                                </div>
                            </div>

                        {% endif %}
                    </div>

                    <!-- PAGINATION -->
                    <div class="text-center mb-3">
                        {{ knp_pagination_render(pagination) }}
                    </div>

                    <!-- FORUM POSTS -->
                    <div class="d-flex flex-column gap-3">

                        {% for question in pagination.items %}

                            <div class="card shadow-sm">

                                <div class="card-body">

                                    <!-- TITLE -->
                                    <h5 class="mb-1">
                                        <a href="{{ url('question_view', {id: question.id}) }}"
                                           class="text-decoration-none">
                                            {{ question.title|markdown_to_html }}
                                        </a>
                                    </h5>

                                    <!-- META -->
                                    <div class="text-muted small mb-2 d-flex flex-wrap gap-2">

                                    <span>
                                        {% if question.author %}
                                            <span class="text-primary fw-bold">{{ question.author.nickname }}</span>
                                        {% else %}
                                            <span class="text-muted">[ deleted user ]</span>
                                        {% endif %}
                                    </span>

                                        <span>•</span>

                                        <span>{{ question.createdAt|date('Y-m-d H:i') }}</span>

                                        {% if question.updatedAt %}
                                            <span class="text-primary">
                                            (edytowane {{ question.updatedAt|date('Y-m-d H:i') }})
                                        </span>
                                        {% endif %}

                                        <span>•</span>

                                        <span>
                                        {{ question.category.name }}
                                    </span>

                                    </div>

                                    <!-- CONTENT PREVIEW -->
                                    <p class="mb-2 text-muted">
                                        {{ question.content|markdown_to_html|replace({'<h1>':'<h3>', '</h1>':'</h3>', '<h2>':'<h3>', '</h2>':'</h3>'})|raw }}
                                    </p>

                                    <!-- TAGS -->
                                    <div class="d-flex flex-wrap gap-1">

                                        {% for tag in question.tags %}
                                            <a href="{{ path('question_list', {tag: tag.id}) }}"
                                               class="badge bg-primary text-decoration-none">
                                                {{ tag.slug }}
                                            </a>
                                        {% else %}
                                            <span class="text-muted small">brak tagów</span>
                                        {% endfor %}

                                    </div>

                                </div>

                            </div>

                        {% endfor %}

                    </div>

                    <!-- PAGINATION BOTTOM -->
                    <div class="text-center mt-4">
                        {{ knp_pagination_render(pagination) }}
                    </div>

                {% else %}
                    <p class="text-muted">
                        {{ 'message.empty_list'|trans }}
                    </p>
                {% endif %}

            </div>

            <!-- RIGHT: SIDEBAR -->
            <div class="col-lg-3">

                <div class="card shadow-sm">
                    <div class="card-body">

                        <h5 class="mb-3">Kategorie</h5>

                        <ul class="list-unstyled gap-2 d-flex flex-wrap">

                            <li class="mb-2">
                                <a href="{{ path('question_list') }}" class="btn btn-sm btn-outline-info text-decoration-none">
                                    wszystkie
                                </a>
                            </li>

                            {% for category in categories %}
                                <li class="mb-2">
                                    <a href="{{ path('question_list', {categoryId: category.id}) }}" class="btn btn-sm btn-info text-decoration-none">
                                        {{ category.name }}
                                    </a>
                                </li>
                            {% endfor %}

                        </ul>

                    </div>
                </div>

                <div class="card shadow-sm mt-4">
                    <div class="card-body">

                        <h5>Cytat dnia</h5>
                        <figure>
                            <blockquote class="blockquote">
                                <p>"Cierpliwość to nie cnota, to jest podstawowy sprzęt wędkarski."</p>
                            </blockquote>
                            <figcaption class="blockquote-footer">
                                SandaczHunter3000 <cite title="Source Title">SPŁAWIK i GRUNT - Postępowy Portal Wędkarski</cite>
                            </figcaption>
                        </figure>
                    </div>
                </div>

            </div>

        </div>
    </div>

{% endblock %}
