{% extends 'base.html.twig' %}

{% block title %}Zmiana hasła{% endblock %}

{% block body %}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h3 class="mb-4">Zmiana hasła</h3>

                    {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_label(form.currentPassword, 'Aktualne hasło', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.currentPassword, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.currentPassword) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.newPassword, 'Nowe hasło', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.newPassword, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.newPassword) }}
                    </div>


                    <div class="d-flex justify-content-between align-items-center mt-4">

                        <a href="{{ url('account_index') }}"
                           class="btn btn-outline-secondary btn-sm">
                            Wróć
                        </a>

                        <button type="submit" class="btn btn-primary">
                            Zmień hasło
                        </button>

                    </div>

                    {{ form_end(form) }}

                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}
