{% extends 'base.html.twig' %}

{% block title %}{{ 'title.change_password'|trans }}{% endblock %}

{% block body %}

    <div class="container py-4">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card shadow-sm border-0">

                    <div class="card-body p-4">

                        <h3 class="mb-4">{{ 'label.change_password'|trans }}</h3>

                        {{ form_start(form) }}

                        <div class="mb-3">
                            {{ form_row(form.currentPassword, {
                                'attr': {
                                    'class': 'form-control'
                                },
                                'label_attr': {
                                    'class': 'form-label'
                                }
                            }) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.newPassword, {
                                'attr': {
                                    'class': 'form-control'
                                },
                                'label_attr': {
                                    'class': 'form-label'
                                }
                            }) }}
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">

                            <a href="{{ url('account_index') }}"
                               class="btn btn-outline-secondary btn-sm">
                                {{ 'label.back'|trans }}
                            </a>

                            <button type="submit" class="btn btn-primary">
                                {{ 'label.save'|trans }}
                            </button>

                        </div>

                        {{ form_end(form) }}

                    </div>

                </div>

            </div>

        </div>

    </div>

{% endblock %}
