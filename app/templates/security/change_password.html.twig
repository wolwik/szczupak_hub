{% extends 'base.html.twig' %}

{% block title %}Zmiana hasła{% endblock %}

{% block body %}
    <div class="container mt-5" style="max-width: 500px;">

        <h2 class="mb-4">Zmiana hasła</h2>

        {{ form_start(form) }}

        <div class="mb-3">
            {{ form_label(form.currentPassword, 'Aktualne hasło', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.currentPassword, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.currentPassword) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.newPassword, 'Nowe hasło', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.newPassword, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.newPassword) }}
        </div>

        <button type="submit" class="btn btn-primary w-100">
            Zmień hasło
        </button>

        {{ form_end(form) }}

    </div>
{% endblock %}
