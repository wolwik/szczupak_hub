{% extends 'base.html.twig' %}

{% block title %}{{ 'title.tag_list'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'label.tag_list'|trans }}</h1>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'title.id'|trans }}</th>
            <th>{{ 'title.name'|trans }}</th>
            <th>Slug</th>
            <th>{{ 'title.actions'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for tag in tags %}
            <tr>
                <td>{{ tag.id }}</td>
                <td>{{ tag.name }}</td>
                <td>{{ tag.slug }}</td>
                <td>
                    <a href="{{ path('tag_edit', {'id': tag.id}) }}" class="btn btn-sm btn-primary">{{ 'label.edit'|trans }}</a>
                    <a href="{{ path('tag_delete', {'id': tag.id}) }}" class="btn btn-sm btn-danger">{{ 'label.delete'|trans }}</a>

                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">{{ 'title.no_records'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('tag_new') }}" class="btn btn-success btn mb-4">{{ 'label.create_new'|trans }}</a>

{% endblock %}
