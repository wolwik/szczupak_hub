{% extends 'base.html.twig' %}

{% block title %}{{ 'title.category_create'|trans }}{% endblock %}

{% block body %}

    <div class="container py-4">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card shadow-sm border-0">

                    <div class="card-body p-4">

                        <h3 class="mb-4">{{ 'label.category_add'|trans }}</h3>

                        {{ include('category/_form.html.twig') }}

                        <div class="d-flex justify-content-between align-items-center mt-4">

                            <a href="{{ path('category_list') }}" class="btn btn-outline-secondary btn-sm">{{ 'label.back'|trans }}</a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

{% endblock %}
