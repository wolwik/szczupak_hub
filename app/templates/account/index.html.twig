{% extends 'base.html.twig' %}

{% block title %}{{ 'title.account'|trans }}{% endblock %}

{% block body %}

    <div class="container py-4">

        <h1 class="mb-4">{{ 'label.user_panel'|trans }}</h1>

        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <!-- AVATAR -->
                <div class="d-flex align-items-center gap-3 mb-4">

                    <div class="avatar-wrapper avatar-lg">
                        {% set avatar_filename = get_user_avatar(app.user) %}

                        {% if avatar_filename %}
                            <img
                                src="{{ asset('uploads/avatars/' ~ avatar_filename) }}"
                                class="avatar-img"
                                alt="avatar"
                            >
                        {% else %}
                            <img
                                src="{{ asset('images/default-user.jpg') }}"
                                class="avatar-img"
                                alt="default avatar"
                            >
                        {% endif %}
                    </div>

                    <a href="{{ url('avatar_create') }}" class="btn btn-sm btn-outline-primary">
                        {{ avatar_filename ? 'label.change_avatar'|trans : 'label.add_avatar'|trans }}
                    </a>

                    <form method="post" action="{{ path('avatar_delete') }}">
                        <button class="btn btn-danger btn-sm">
                            {{ 'label.delete_avatar'|trans }}
                        </button>
                    </form>

                </div>

                <!-- USER DATA -->

                <div class="mb-2">
                    <div class="text-muted small">{{ 'label.email'|trans }}</div>
                    <div class="fs-6">{{ app.user.email }}</div>
                </div>

                <div class="mb-3">
                    <div class="text-muted small">{{ 'label.nickname'|trans }}</div>
                    <div class="fs-6">{{ app.user.nickname }}</div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a href="{{ path('account_edit') }}" class="btn btn-outline-primary btn-sm">
                        {{ 'label.edit_user_data'|trans }}
                    </a>

                    <a href="{{ path('change_password') }}" class="btn btn-outline-secondary btn-sm">
                        {{ 'label.change_password'|trans }}
                    </a>
                </div>

            </div>
        </div>


        <!-- DRAFTS -->

        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h5 class="card-title mb-3">{{ 'label.drafts'|trans }}</h5>

                {% if drafts is empty %}
                    <div class="text-muted">{{ 'label.no_records'|trans }}</div>
                {% else %}

                    <ul class="list-group list-group-flush">

                        {% for question in drafts %}
                            <li class="list-group-item">
                                <a href="{{ path('question_view', {id: question.id}) }}">
                                    {{ question.title }}
                                </a>

                            </li>
                        {% endfor %}

                    </ul>

                {% endif %}

            </div>
        </div>


        <!-- ADMIN PANEL -->
        {% if is_granted('ROLE_ADMIN') %}
            <div class="card shadow-sm mb-4 border-warning">
                <div class="card-body">

                    <h5 class="card-title mb-3">{{ 'label.admin_panel'|trans }}</h5>

                    <div class="d-flex gap-2 flex-wrap">
                        <a href="{{ path('question_list') }}" class="btn btn-outline-primary btn-sm">
                            {{ 'label.question-photos'|trans }}
                        </a>

                        <a href="{{ path('category_list') }}" class="btn btn-outline-primary btn-sm">
                            {{ 'label.categories'|trans }}
                        </a>

                        <a href="{{ path('tag_list') }}" class="btn btn-outline-primary btn-sm">
                            {{ 'label.tags'|trans }}
                        </a>

                        <a href="{{ path('user_list') }}" class="btn btn-outline-primary btn-sm">
                            {{ 'label.users'|trans }}
                        </a>

                    </div>

                </div>
            </div>
        {% endif %}

        <!-- DELETE ACCOUNT -->
        <div class="card shadow-sm border-danger">
            <div class="card-body d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="card-title mb-1 text-danger">{{ 'label.delete_account'|trans }}</h5>
                    <div class="text-muted small">{{ 'label.irreversible_action'|trans }}</div>
                </div>

                <a href="{{ url('account_delete') }}" class="btn btn-danger btn-sm">
                    {{ 'label.delete_account'|trans }}
                </a>

            </div>
        </div>

    </div>

{% endblock %}
