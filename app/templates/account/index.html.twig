{% extends 'base.html.twig' %}

{% block title %}Panel użytkownika{% endblock %}

{% block body %}

    <div class="container py-4">

        <h1 class="mb-4">Panel użytkownika</h1>

        <!-- DANE UŻYTKOWNIKA -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h5 class="card-title mb-3">Dane konta</h5>

                <div class="mb-2">
                    <div class="text-muted small">Email</div>
                    <div class="fs-6">{{ app.user.email }}</div>
                </div>

                <div class="mb-3">
                    <div class="text-muted small">Nickname</div>
                    <div class="fs-6">{{ app.user.nickname }}</div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a href="{{ path('account_edit') }}" class="btn btn-outline-primary btn-sm">
                        Edytuj dane
                    </a>

                    <a href="{{ path('change_password') }}" class="btn btn-outline-secondary btn-sm">
                        Zmień hasło
                    </a>
                </div>

            </div>
        </div>

        <!-- ADMIN -->
        {% if is_granted('ROLE_ADMIN') %}
            <div class="card shadow-sm mb-4 border-warning">
                <div class="card-body">

                    <h5 class="card-title mb-3">Administracja</h5>

                    <div class="d-flex gap-2 flex-wrap">
                        <a href="{{ path('question_list') }}" class="btn btn-outline-primary btn-sm">
                            Pytania
                        </a>

                        <a href="{{ path('category_list') }}" class="btn btn-outline-primary btn-sm">
                            Kategorie
                        </a>

                        <a href="{{ path('tag_list') }}" class="btn btn-outline-primary btn-sm">
                            Tagi
                        </a>

                        <a href="{{ path('user_list') }}" class="btn btn-outline-primary btn-sm">
                            Użytkownicy
                        </a>

                    </div>

                </div>
            </div>
        {% endif %}

        <!-- DANGER ZONE -->
        <div class="card shadow-sm border-danger">
            <div class="card-body d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="card-title mb-1 text-danger">Strefa niebezpieczna</h5>
                    <div class="text-muted small">Usunięcie konta jest nieodwracalne</div>
                </div>

                <a href="{{ url('account_delete') }}" class="btn btn-danger btn-sm">
                    Usuń konto
                </a>

            </div>
        </div>

    </div>

{% endblock %}
